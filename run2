# 1. Kill any running processes
pkill -f nodemon
pkill -f react-scripts

# 2. Fix database permissions
cd ~/Downloads/2027/messaging\ app/meshchat/backend
rm -f database/meshchat.db
mkdir -p database
chmod 755 database
touch database/meshchat.db
chmod 666 database/meshchat.db

# 3. Seed the database
npm run seed

# 4. Start backend
npm run dev

# 5. In a new terminal, start frontend
cd ~/Downloads/2027/messaging\ app/meshchat/frontend
npm start

